{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@youtube-live-studio/core": ["../../packages/core/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../../packages/core/src/**/*.ts"]
}